# Port for the server to run on
PORT=5001

# MongoDB URI for connecting to your database
MONGO_URI=mongodb://127.0.0.1:27017/scholarsscroll

# Secret key for signing JWT tokens (you should change this in production to a more secure key)
JWT_SECRET=YourStrongSecretKey

# Environment settings - for example, to distinguish between development and production
NODE_ENV=development
